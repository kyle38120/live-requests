{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "database.rules.json", "README.md", "CLAUDE.md", "docs/**", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      { "source": "/firebase-config.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  }
}
